# Supabase (novi, ZASEBAN projekat "Rakija" — nije isto što i BezBrige!)
# Popuni nakon kreiranja projekta na supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable / anon key>"

# Samo za server (admin operacije, uvoz proizvođača). NIKADA u klijent!
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Bazni URL sajta (za sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL="https://tvoj-domen.rs"

# Admin panel (/admin)
ADMIN_LOZINKA="<izaberi-jaku-lozinku>"
# Opciono: tajni ključ za potpis admin sesije (ako se ne postavi, koristi se service_role)
ADMIN_SECRET="<nasumičan-string>"
