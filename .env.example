# Supabase (novi, ZASEBAN projekat "Rakija" — nije isto što i BezBrige!)
# Popuni nakon kreiranja projekta na supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable / anon key>"

# Samo za server (admin operacije, uvoz proizvođača). NIKADA u klijent!
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Bazni URL sajta (za sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL="https://tvoj-domen.rs"

# Admin panel (/admin) — prijava preko Supabase Auth
# Napravi korisnika u Supabase: Authentication -> Users -> Add user (email + lozinka).
# Lista dozvoljenih admin emailova (zarezom razdvojeni). Prazno = svaki autentikovan korisnik.
ADMIN_EMAILS="chumpitas@gmail.com"

# Email obaveštenja (Resend) — opciono; bez ključa se mejlovi ne šalju
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Rakija <onboarding@resend.dev>"
EMAIL_TO="chumpitas@gmail.com"
